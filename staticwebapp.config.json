{
  "routes": [
    {
      "route": "/.auth/*",
      "statusCode": 404
    },
    {
      "route": "/auth.html",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/LORANG_RELOAD_V1.1.html",
      "statusCode": 404
    },
    {
      "route": "/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "same-origin"
  },
  "navigationFallback": {
    "rewrite": "/LORANG_RELOAD_V1.2.html"
  }
}